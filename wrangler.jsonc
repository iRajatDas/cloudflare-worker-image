{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image",
  "main": "src/index.js",
  "compatibility_date": "2025-06-24",
  "vars": {
    "WHITE_LIST": "",
    "DISABLE_RATE_LIMIT": "false"
  },
  "observability": {
    "enabled": true
  },

  // ── Photon container (image processing engine) ──
  "containers": [
    {
      "max_instances": 3,
      "name": "photon-container",
      "class_name": "PhotonContainer",
      "image": "./Dockerfile",
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PHOTON_CONTAINER",
        "class_name": "PhotonContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PhotonContainer"]
    }
  ],

  // ── R2 bucket for temp file storage (bulk jobs) ──
  // Create first: npx wrangler r2 bucket create image-processing
  "r2_buckets": [
    {
      "binding": "IMAGE_BUCKET",
      "bucket_name": "image-processing"
    }
  ],

  // ── KV namespace for job state (auto-expires) ──
  // Create first: npx wrangler kv namespace create JOB_STATE
  // Then paste the returned id below
  "kv_namespaces": [
    {
      "binding": "JOB_STATE",
      "id": "953d6a7381b3443bb152e6d4c5bad4c2"
    }
  ],

  // ── Scheduled cleanup for expired R2 objects ──
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
